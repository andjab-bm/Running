{
  "components": {
    "schemas": {
      "Activity": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ActivitySummary"
          },
          {
            "properties": {
              "description": {
                "type": "string"
              },
              "has_original": {
                "type": "boolean"
              },
              "laps": {
                "items": {
                  "$ref": "#/components/schemas/Segment"
                },
                "type": "array"
              },
              "metrics_version": {
                "type": "integer"
              },
              "source_format": {
                "enum": [
                  "gpx",
                  "fit"
                ],
                "type": "string"
              },
              "splits": {
                "items": {
                  "$ref": "#/components/schemas/Segment"
                },
                "type": "array"
              },
              "zones": {
                "properties": {
                  "bounds": {
                    "items": {
                      "type": "number"
                    },
                    "type": "array"
                  },
                  "seconds": {
                    "items": {
                      "type": "number"
                    },
                    "maxItems": 5,
                    "minItems": 5,
                    "type": "array"
                  },
                  "uses_default_hr_max": {
                    "type": "boolean"
                  }
                },
                "type": [
                  "object",
                  "null"
                ]
              }
            },
            "type": "object"
          }
        ]
      },
      "ActivityPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ActivitySummary"
            },
            "type": "array"
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "ActivitySummary": {
        "properties": {
          "avg_cad": {
            "type": [
              "number",
              "null"
            ]
          },
          "avg_hr": {
            "type": [
              "number",
              "null"
            ]
          },
          "copied_from": {
            "description": "Activity this one was copied from",
            "type": [
              "integer",
              "null"
            ]
          },
          "distance": {
            "type": "number"
          },
          "effort": {
            "description": "Relative effort; null without heart rate",
            "type": [
              "number",
              "null"
            ]
          },
          "elapsed_time": {
            "type": "number"
          },
          "gain": {
            "type": [
              "number",
              "null"
            ]
          },
          "gap_speed": {
            "type": [
              "number",
              "null"
            ]
          },
          "id": {
            "type": "integer"
          },
          "loss": {
            "type": [
              "number",
              "null"
            ]
          },
          "max_hr": {
            "type": [
              "number",
              "null"
            ]
          },
          "moving_time": {
            "type": "number"
          },
          "preview": {
            "description": "Simplified trace as [lat, lon] pairs",
            "items": {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            "type": "array"
          },
          "profile_id": {
            "type": "integer"
          },
          "rpe": {
            "maximum": 10,
            "minimum": 1,
            "type": [
              "integer",
              "null"
            ]
          },
          "speed": {
            "type": "number"
          },
          "sport": {
            "type": [
              "string",
              "null"
            ]
          },
          "start_time": {
            "description": "Unix seconds, UTC",
            "type": "number"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "Error": {
        "properties": {
          "error": {
            "description": "Stable code",
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "error",
          "message"
        ],
        "type": "object"
      },
      "Health": {
        "properties": {
          "database": {
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "ImportResult": {
        "properties": {
          "results": {
            "items": {
              "properties": {
                "activity_id": {
                  "description": "Created activity, or the existing one for a duplicate",
                  "type": "integer"
                },
                "file": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "imported",
                    "duplicate",
                    "failed"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "file",
                "status"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "Journal": {
        "description": "Fields left out are kept; rpe null clears it; tags replaces the whole set.",
        "properties": {
          "description": {
            "type": "string"
          },
          "rpe": {
            "maximum": 10,
            "minimum": 1,
            "type": [
              "integer",
              "null"
            ]
          },
          "tags": {
            "items": {
              "maxLength": 40,
              "type": "string"
            },
            "maxItems": 20,
            "type": "array"
          },
          "title": {
            "maxLength": 200,
            "type": "string"
          }
        },
        "type": "object"
      },
      "NewProfile": {
        "properties": {
          "color": {
            "type": "string"
          },
          "name": {
            "maxLength": 24,
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "Profile": {
        "properties": {
          "activity_count": {
            "type": "integer"
          },
          "color": {
            "examples": [
              "#B9AFFF"
            ],
            "type": "string"
          },
          "hr_max": {
            "type": [
              "integer",
              "null"
            ]
          },
          "hr_rest": {
            "type": [
              "integer",
              "null"
            ]
          },
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "timezone": {
            "type": [
              "string",
              "null"
            ]
          },
          "units": {
            "enum": [
              "metric",
              "imperial"
            ],
            "type": "string"
          },
          "zones": {
            "$ref": "#/components/schemas/Zones"
          }
        },
        "type": "object"
      },
      "ProfileChanges": {
        "description": "Fields left out are kept; null clears hr_max, hr_rest, zone_bounds (back to defaults) or timezone.",
        "properties": {
          "color": {
            "type": "string"
          },
          "hr_max": {
            "maximum": 230,
            "minimum": 100,
            "type": [
              "integer",
              "null"
            ]
          },
          "hr_rest": {
            "type": [
              "integer",
              "null"
            ]
          },
          "name": {
            "maxLength": 24,
            "type": "string"
          },
          "timezone": {
            "type": [
              "string",
              "null"
            ]
          },
          "units": {
            "enum": [
              "metric",
              "imperial"
            ],
            "type": "string"
          },
          "zone_bounds": {
            "items": {
              "type": "number"
            },
            "maxItems": 6,
            "minItems": 6,
            "type": [
              "array",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "Segment": {
        "description": "A split, a lap, or a whole activity. SI units.",
        "properties": {
          "avg_cad": {
            "description": "Steps per minute, both legs",
            "type": [
              "number",
              "null"
            ]
          },
          "avg_hr": {
            "type": [
              "number",
              "null"
            ]
          },
          "distance": {
            "description": "Metres",
            "type": "number"
          },
          "elapsed_time": {
            "description": "Seconds",
            "type": "number"
          },
          "gain": {
            "type": [
              "number",
              "null"
            ]
          },
          "gap_speed": {
            "type": [
              "number",
              "null"
            ]
          },
          "loss": {
            "type": [
              "number",
              "null"
            ]
          },
          "moving_time": {
            "description": "Seconds",
            "type": "number"
          },
          "speed": {
            "description": "Metres per second over moving time",
            "type": "number"
          },
          "start_t": {
            "description": "Seconds from the start of the activity",
            "type": "number"
          }
        },
        "type": "object"
      },
      "Streams": {
        "description": "All arrays have `count` entries and share one index.",
        "properties": {
          "cad": {
            "items": {
              "type": [
                "number",
                "null"
              ]
            },
            "type": [
              "array",
              "null"
            ]
          },
          "count": {
            "type": "integer"
          },
          "dist": {
            "description": "Metres",
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "ele": {
            "items": {
              "type": [
                "number",
                "null"
              ]
            },
            "type": [
              "array",
              "null"
            ]
          },
          "hr": {
            "items": {
              "type": [
                "number",
                "null"
              ]
            },
            "type": [
              "array",
              "null"
            ]
          },
          "lat": {
            "items": {
              "type": [
                "number",
                "null"
              ]
            },
            "type": [
              "array",
              "null"
            ]
          },
          "lon": {
            "items": {
              "type": [
                "number",
                "null"
              ]
            },
            "type": [
              "array",
              "null"
            ]
          },
          "moving": {
            "items": {
              "type": "boolean"
            },
            "type": "array"
          },
          "resolution": {
            "enum": [
              "low",
              "full"
            ],
            "type": "string"
          },
          "speed": {
            "description": "Metres per second",
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "t": {
            "description": "Seconds since start",
            "items": {
              "type": "number"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "Transfer": {
        "properties": {
          "keep_hr": {
            "default": false,
            "description": "Copies only",
            "type": "boolean"
          },
          "profile_id": {
            "type": "integer"
          }
        },
        "required": [
          "profile_id"
        ],
        "type": "object"
      },
      "Zones": {
        "properties": {
          "bounds": {
            "description": "Lower bound of zones 1–5, then the maximum (bpm)",
            "items": {
              "type": "number"
            },
            "maxItems": 6,
            "minItems": 6,
            "type": "array"
          },
          "custom": {
            "type": "boolean"
          },
          "default_hr_max": {
            "type": "number"
          },
          "uses_default_hr_max": {
            "type": "boolean"
          }
        },
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Self-hosted running tracker. No authentication: the service must only be reachable from a trusted network. Quantities are in SI units (metres, seconds, metres per second) and times are Unix seconds in UTC; clients convert for display.",
    "title": "Running API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/activities/{id}": {
      "delete": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "description": "Any value. Required on every state-changing request; cross-site requests are refused.",
            "in": "header",
            "name": "X-Requested-With",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Cross-site request or missing X-Requested-With header"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "No such profile or activity"
          }
        },
        "summary": "Delete an activity and its original file"
      },
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Activity"
                }
              }
            },
            "description": "Activity"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "No such profile or activity"
          }
        },
        "summary": "Read an activity with splits, laps and zones"
      },
      "patch": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "description": "Any value. Required on every state-changing request; cross-site requests are refused.",
            "in": "header",
            "name": "X-Requested-With",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Journal"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Activity"
                }
              }
            },
            "description": "Updated"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Cross-site request or missing X-Requested-With header"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "No such profile or activity"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Validation error"
          }
        },
        "summary": "Edit the journal of an activity"
      }
    },
    "/activities/{id}/copy": {
      "post": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "description": "Any value. Required on every state-changing request; cross-site requests are refused.",
            "in": "header",
            "name": "X-Requested-With",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Transfer"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "activity_id": {
                      "type": "integer"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Copied; heart rate is omitted unless keep_hr"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Cross-site request or missing X-Requested-With header"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "No such profile or activity"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Already present in that profile; activity_id names the existing one"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Validation error"
          }
        },
        "summary": "Copy an activity to another profile"
      }
    },
    "/activities/{id}/export.gpx": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/gpx+xml": {}
            },
            "description": "GPX 1.1 document"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "No such profile or activity"
          }
        },
        "summary": "Download the activity as GPX 1.1"
      }
    },
    "/activities/{id}/move": {
      "post": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "description": "Any value. Required on every state-changing request; cross-site requests are refused.",
            "in": "header",
            "name": "X-Requested-With",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Transfer"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "activity_id": {
                      "type": "integer"
                    },
                    "profile_id": {
                      "type": "integer"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Moved; zone figures recomputed for the target profile"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Cross-site request or missing X-Requested-With header"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "No such profile or activity"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Validation error"
          }
        },
        "summary": "Move an activity to another profile"
      }
    },
    "/activities/{id}/original": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/gpx+xml": {},
              "application/octet-stream": {}
            },
            "description": "The uploaded file, byte for byte"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "No such profile or activity"
          }
        },
        "summary": "Download the unmodified uploaded file"
      }
    },
    "/activities/{id}/streams": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "description": "low returns at most 2000 points",
            "in": "query",
            "name": "resolution",
            "schema": {
              "default": "low",
              "enum": [
                "low",
                "full"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Streams"
                }
              }
            },
            "description": "Series"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "No such profile or activity"
          }
        },
        "summary": "Index-aligned sample series"
      }
    },
    "/health": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Healthy"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Data store unreachable"
          }
        },
        "summary": "Service and data store status"
      }
    },
    "/profiles": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "profiles": {
                      "items": {
                        "$ref": "#/components/schemas/Profile"
                      },
                      "type": "array"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Profiles"
          }
        },
        "summary": "List household profiles"
      },
      "post": {
        "parameters": [
          {
            "description": "Any value. Required on every state-changing request; cross-site requests are refused.",
            "in": "header",
            "name": "X-Requested-With",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewProfile"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            },
            "description": "Created"
          },
          "403": {
