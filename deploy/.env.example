# Copy to .env (next to compose.yaml) and uncomment what you want to change.
# Without a .env file the values shown here apply.

# Port of the web app and API on the home network.
#PORT=8080

# Where the database and the original files are kept: a Docker volume name, or a directory
# on the host such as /srv/running (it must be writable by user 65532, see docs/deployment.md).
#DATA_VOLUME=running-data

# Largest accepted file, in megabytes.
#MAX_UPLOAD_MB=50

# Map background (a MapLibre style URL). Tiles are fetched by the browser from that host.
# Leave unset for the public OpenFreeMap styles; set to nothing to disable the background:
#MAP_STYLE_URL=
# Style used with the dark theme; follows MAP_STYLE_URL when that one is changed.
#MAP_STYLE_URL_DARK=

# Image to run instead of building it here (for example one built on another machine).
#IMAGE=running:local
